DATABASE_URL=postgresql+asyncpg://opsbridge:opsbridge@localhost:5432/opsbridge
WEBHOOK_SECRET=change-me
GITHUB_TOKEN=
# LLM: Groq free tier (OpenAI-compatible). Leave GROQ_API_KEY empty to use the offline heuristic.
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
CONFIDENCE_THRESHOLD=0.85
EVAL_PASS_THRESHOLD=0.85
# Policy embeddings: Gemini API (https://aistudio.google.com/apikey). Empty key -> offline hash
# embedder (retrieval is then meaningless). Changing EMBEDDING_DIM needs a table migration.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
# Policies scoring below this similarity count as absent (calibrate against real embeddings).
MIN_POLICY_SCORE=0.5
# Console writes (approve/reject) need `Authorization: Bearer <OPERATOR_TOKEN>`; empty = no auth.
OPERATOR_TOKEN=
CORS_ORIGINS=http://localhost:3000
